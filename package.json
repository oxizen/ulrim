{
  "name": "ulrim",
  "version": "1.7.3",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:mac": "unset ELECTRON_RUN_AS_NODE && electron .",
    "build": "electron-builder --win",
    "build:mac": "electron-builder --mac -c.mac.notarize=false"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "울림 - Live performance sound board",
  "build": {
    "appId": "com.ulrim.soundboard",
    "productName": "울림",
    "afterPack": "build/afterPack.js",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png",
      "extraResources": [
        {
          "from": "ble-bridge/bin/publish/ble-bridge.exe",
          "to": "ble-bridge.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.png",
      "notarize": false
    },
    "publish": {
      "provider": "github",
      "owner": "oxizen",
      "repo": "ulrim"
    }
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "node-hid": "^3.3.0"
  }
}
